{
  "cells": [
    {
      "cell_type": "markdown",
      "source": [
        "# 4 — Visualization & Diagnostics (Fixed)\n",
        "\n",
        "**Perbaikan dari audit:**\n",
        "- ✅ Multi-province visualization (bukan cherry-picked 1 provinsi)\n",
        "- ✅ Residual diagnostic plot\n",
        "- ✅ Correlation heatmap\n",
        "- ✅ Distribution plots\n",
        "- ❌ Tidak ada causal claim (\"Domino Effect\") tanpa bukti statistik\n",
        "\n",
        "**Input:**\n",
        "- `3_modelling/output/3_model_predictions.csv`\n",
        "- `3_modelling/output/per_province_metrics.csv`\n",
        "- `2_data_preprocessing/output/2.2_final_feature_set.csv`"
      ],
      "metadata": {},
      "id": "737a95e2"
    },
    {
      "cell_type": "code",
      "source": [
        "from pathlib import Path\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "plt.rcParams.update({'figure.dpi': 120, 'font.size': 10})\n",
        "\n",
        "def find_project_root(start: Path) -> Path:\n",
        "    start = start.resolve()\n",
        "    for p in [start, *start.parents]:\n",
        "        if (p / '3_modelling' / 'output' / '3_model_predictions.csv').exists():\n",
        "            return p\n",
        "    raise FileNotFoundError('Could not find 3_model_predictions.csv')\n",
        "\n",
        "ROOT = find_project_root(Path.cwd())\n",
        "output_dir = ROOT / '4_visualization' / 'output'\n",
        "output_dir.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "df_pred = pd.read_csv(ROOT / '3_modelling' / 'output' / '3_model_predictions.csv')\n",
        "df_pred['tanggal'] = pd.to_datetime(df_pred['tanggal'])\n",
        "\n",
        "df_feat = pd.read_csv(ROOT / '2_data_preprocessing' / 'output' / '2.2_final_feature_set.csv')\n",
        "df_feat['tanggal'] = pd.to_datetime(df_feat['tanggal'])\n",
        "\n",
        "prov_metrics_path = ROOT / '3_modelling' / 'output' / 'per_province_metrics.csv'\n",
        "if prov_metrics_path.exists():\n",
        "    df_prov_m = pd.read_csv(prov_metrics_path)\n",
        "\n",
        "metrics_path = ROOT / '3_modelling' / 'output' / 'model_metrics.csv'\n",
        "if metrics_path.exists():\n",
        "    print('=== Model Metrics ===')\n",
        "    display(pd.read_csv(metrics_path))\n",
        "\n",
        "print(f'Predictions: {len(df_pred):,} rows | Features: {len(df_feat):,} rows')"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "=== Model Metrics ===\n"
        },
        {
          "output_type": "display_data",
          "data": {
            "text/plain": "                 model      rmse       mae        r2\n0      XGBoost (Train)  0.002249  0.001540  0.952795\n1       XGBoost (Test)  0.006226  0.002706  0.668079\n2  Naive (Random Walk)  0.004923  0.002012  0.792422",
            "text/html": "<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>model</th>\n      <th>rmse</th>\n      <th>mae</th>\n      <th>r2</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>XGBoost (Train)</td>\n      <td>0.002249</td>\n      <td>0.001540</td>\n      <td>0.952795</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>XGBoost (Test)</td>\n      <td>0.006226</td>\n      <td>0.002706</td>\n      <td>0.668079</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>Naive (Random Walk)</td>\n      <td>0.004923</td>\n      <td>0.002012</td>\n      <td>0.792422</td>\n    </tr>\n  </tbody>\n</table>\n</div>"
          },
          "metadata": {}
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "Predictions: 372 rows | Features: 1,488 rows\n"
        }
      ],
      "execution_count": 6,
      "metadata": {
        "gather": {
          "logged": 1777516058970
        }
      },
      "id": "26f170d7"
    },
    {
      "cell_type": "code",
      "source": [
        "# === 1. Pred vs Actual — SEMUA provinsi (sample 6) ===\n",
        "sample_provs = df_pred['provinsi_id'].unique()[:6]\n",
        "fig, axes = plt.subplots(2, 3, figsize=(16, 8), sharex=True)\n",
        "axes = axes.flatten()\n",
        "\n",
        "for i, prov_id in enumerate(sample_provs):\n",
        "    pdata = df_pred[df_pred['provinsi_id'] == prov_id].sort_values('tanggal')\n",
        "    ax = axes[i]\n",
        "    ax.plot(pdata['tanggal'], pdata['y_true'], label='Actual', lw=2)\n",
        "    ax.plot(pdata['tanggal'], pdata['y_pred'], label='Predicted', lw=2, ls='--')\n",
        "    ax.set_title(f'{pdata[\"nama_provinsi\"].iloc[0]} (ID={prov_id})', fontsize=9)\n",
        "    ax.tick_params(axis='x', rotation=45)\n",
        "    ax.grid(True, alpha=0.3)\n",
        "    if i == 0:\n",
        "        ax.legend(fontsize=8)\n",
        "\n",
        "fig.suptitle('Prediction vs Actual (Test Set 2025) — 6 Provinces', fontweight='bold')\n",
        "fig.tight_layout()\n",
        "fig.savefig(output_dir / 'pred_vs_actual_multi.png', dpi=150, bbox_inches='tight')\n",
        "plt.show()"
      ],
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": "<Figure size 1920x960 with 6 Axes>",
            "image/png": ""
          },
          "metadata": {}
        }
      ],
      "execution_count": 7,
      "metadata": {
        "gather": {
          "logged": 1777516075237
        }
      },
      "id": "d0ed00f3"
    },
    {
      "cell_type": "code",
      "source": [
        "# === 2. Residual Diagnostics ===\n",
        "fig, axes = plt.subplots(1, 3, figsize=(16, 4))\n",
        "\n",
        "# Residual distribution\n",
        "axes[0].hist(df_pred['error'], bins=40, edgecolor='black', alpha=0.7)\n",
        "axes[0].axvline(0, color='red', ls='--')\n",
        "axes[0].set_title('Residual Distribution')\n",
        "axes[0].set_xlabel('Error (pred - actual)')\n",
        "\n",
        "# Residual vs predicted\n",
        "axes[1].scatter(df_pred['y_pred'], df_pred['error'], alpha=0.4, s=15)\n",
        "axes[1].axhline(0, color='red', ls='--')\n",
        "axes[1].set_title('Residual vs Predicted')\n",
        "axes[1].set_xlabel('Predicted')\n",
        "axes[1].set_ylabel('Error')\n",
        "\n",
        "# Actual vs Predicted scatter\n",
        "axes[2].scatter(df_pred['y_true'], df_pred['y_pred'], alpha=0.4, s=15)\n",
        "lims = [min(df_pred['y_true'].min(), df_pred['y_pred'].min()),\n",
        "        max(df_pred['y_true'].max(), df_pred['y_pred'].max())]\n",
        "axes[2].plot(lims, lims, 'r--', label='Perfect prediction')\n",
        "axes[2].set_title('Actual vs Predicted')\n",
        "axes[2].set_xlabel('Actual')\n",
        "axes[2].set_ylabel('Predicted')\n",
        "axes[2].legend(fontsize=8)\n",
        "\n",
        "fig.tight_layout()\n",
        "fig.savefig(output_dir / 'residual_diagnostics.png', dpi=150, bbox_inches='tight')\n",
        "plt.show()"
      ],
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": "<Figure size 1920x480 with 3 Axes>",
            "image/png": ""
          },
          "metadata": {}
        }
      ],
      "execution_count": 8,
      "metadata": {
        "gather": {
          "logged": 1777516100146
        }
      },
      "id": "f09917ae"
    },
    {
      "cell_type": "code",
      "source": [
        "# === 3. Per-Province RMSE bar chart ===\n",
        "if 'df_prov_m' in dir():\n",
        "    fig, ax = plt.subplots(figsize=(14, 6))\n",
        "    prov_sorted = df_prov_m.sort_values('rmse_model', ascending=True)\n",
        "    y_pos = range(len(prov_sorted))\n",
        "    ax.barh(y_pos, prov_sorted['rmse_model'], label='Model RMSE', alpha=0.8)\n",
        "    ax.barh(y_pos, prov_sorted['rmse_naive'], label='Naive RMSE', alpha=0.4)\n",
        "    ax.set_yticks(y_pos)\n",
        "    ax.set_yticklabels(prov_sorted['nama_provinsi'], fontsize=7)\n",
        "    ax.set_xlabel('RMSE')\n",
        "    ax.set_title('Per-Province RMSE: Model vs Naive Baseline')\n",
        "    ax.legend()\n",
        "    fig.tight_layout()\n",
        "    fig.savefig(output_dir / 'per_province_rmse.png', dpi=150, bbox_inches='tight')\n",
        "    plt.show()\n",
        "\n",
        "# === 4. TWP90 Distribution ===\n",
        "fig, ax = plt.subplots(figsize=(10, 4))\n",
        "ax.hist(df_feat['twp90_pct'], bins=50, edgecolor='black', alpha=0.7)\n",
        "ax.set_title('Distribution of TWP90 (%)')\n",
        "ax.set_xlabel('twp90_pct')\n",
        "ax.axvline(df_feat['twp90_pct'].median(), color='red', ls='--', label=f'Median: {df_feat[\"twp90_pct\"].median():.4f}')\n",
        "ax.legend()\n",
        "fig.tight_layout()\n",
        "fig.savefig(output_dir / 'twp90_distribution.png', dpi=150, bbox_inches='tight')\n",
        "plt.show()"
      ],
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": "<Figure size 1680x720 with 1 Axes>",
            "image/png": ""
          },
          "metadata": {}
        },
        {
          "output_type": "display_data",
          "data": {
            "text/plain": "<Figure size 1200x480 with 1 Axes>",
            "image/png": ""
          },
          "metadata": {}
        }
      ],
      "execution_count": 4,
      "metadata": {
        "gather": {
          "logged": 1777515874650
        }
      },
      "id": "a1b2c3d5"
    },
    {
      "cell_type": "code",
      "source": [
        "# === 5. Correlation Heatmap (fitur utama) ===\n",
        "core_cols = ['twp90_pct', 'x1_bi_rate_pct', 'x2_inflasi_yoy',\n",
        "             'x3_pdrb_per_kapita', 'x4_tpt_pct',\n",
        "             'x5_penetrasi_internet_pct', 'x8_ldr_pct',\n",
        "             'x9_npl_ratio', 'x10_rasio_umkm']\n",
        "core_cols = [c for c in core_cols if c in df_feat.columns]\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(10, 8))\n",
        "corr = df_feat[core_cols].corr()\n",
        "sns.heatmap(corr, annot=True, fmt='.2f', cmap='RdBu_r', center=0, ax=ax,\n",
        "            square=True, linewidths=0.5)\n",
        "ax.set_title('Correlation Heatmap (Core Features)')\n",
        "fig.tight_layout()\n",
        "fig.savefig(output_dir / 'correlation_heatmap.png', dpi=150, bbox_inches='tight')\n",
        "plt.show()\n",
        "\n",
        "print('\\nAll visualizations saved to:', output_dir)"
      ],
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": "<Figure size 1200x960 with 2 Axes>",
            "image/png": ""
          },
          "metadata": {}
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "\nAll visualizations saved to: /mnt/batch/tasks/shared/LS_root/mounts/clusters/bimyusufk/code/Users/bim.yusufk/Microsoft-Datathon-TWP90-Early-Warning-System/4_visualization/output\n"
        }
      ],
      "execution_count": 5,
      "metadata": {
        "gather": {
          "logged": 1777515877597
        }
      },
      "id": "66f2cc25"
    }
