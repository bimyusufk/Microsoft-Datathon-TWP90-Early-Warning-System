           Riau     0.00160     0.00137   \n11           12   Kepulauan Bangka Belitung     0.00153     0.00178   \n22           24             Sulawesi Tengah     0.00153     0.00117   \n23           25              Sulawesi Barat     0.00128     0.00222   \n24           26            Sulawesi Selatan     0.00115     0.00093   \n\n    beats_naive  \n1         False  \n5         False  \n4         False  \n26        False  \n20        False  \n27        False  \n25        False  \n6          True  \n0         False  \n29        False  \n2         False  \n14        False  \n8         False  \n15        False  \n28        False  \n3          True  \n17         True  \n21        False  \n19        False  \n7         False  \n13        False  \n12        False  \n18        False  \n30        False  \n16        False  \n10        False  \n9         False  \n11         True  \n22        False  \n23         True  \n24        False  ",
            "text/html": "<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>provinsi_id</th>\n      <th>nama_provinsi</th>\n      <th>rmse_model</th>\n      <th>rmse_naive</th>\n      <th>beats_naive</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>1</th>\n      <td>2</td>\n      <td>Dki Jakarta</td>\n      <td>0.02990</td>\n      <td>0.02312</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>5</th>\n      <td>6</td>\n      <td>Jawa Timur</td>\n      <td>0.00733</td>\n      <td>0.00483</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>5</td>\n      <td>Daerah Istimewa Yogyakarta</td>\n      <td>0.00611</td>\n      <td>0.00571</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>26</th>\n      <td>28</td>\n      <td>Bali</td>\n      <td>0.00432</td>\n      <td>0.00394</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>20</th>\n      <td>22</td>\n      <td>Sulawesi Utara</td>\n      <td>0.00416</td>\n      <td>0.00304</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>27</th>\n      <td>29</td>\n      <td>Nusa Tenggara Barat</td>\n      <td>0.00390</td>\n      <td>0.00315</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>25</th>\n      <td>27</td>\n      <td>Sulawesi Tenggara</td>\n      <td>0.00386</td>\n      <td>0.00076</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>6</th>\n      <td>7</td>\n      <td>Aceh</td>\n      <td>0.00354</td>\n      <td>0.00406</td>\n      <td>True</td>\n    </tr>\n    <tr>\n      <th>0</th>\n      <td>1</td>\n      <td>Banten</td>\n      <td>0.00348</td>\n      <td>0.00348</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>29</th>\n      <td>31</td>\n      <td>Maluku Utara</td>\n      <td>0.00331</td>\n      <td>0.00199</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>3</td>\n      <td>Jawa Barat</td>\n      <td>0.00318</td>\n      <td>0.00266</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>14</th>\n      <td>15</td>\n      <td>Bengkulu</td>\n      <td>0.00314</td>\n      <td>0.00187</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>8</th>\n      <td>9</td>\n      <td>Sumatera Barat</td>\n      <td>0.00300</td>\n      <td>0.00281</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>15</th>\n      <td>16</td>\n      <td>Lampung</td>\n      <td>0.00293</td>\n      <td>0.00286</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>28</th>\n      <td>30</td>\n      <td>Nusa Tenggara Timur</td>\n      <td>0.00282</td>\n      <td>0.00221</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>4</td>\n      <td>Jawa Tengah</td>\n      <td>0.00280</td>\n      <td>0.00308</td>\n      <td>True</td>\n    </tr>\n    <tr>\n      <th>17</th>\n      <td>18</td>\n      <td>Kalimantan Tengah</td>\n      <td>0.00275</td>\n      <td>0.00309</td>\n      <td>True</td>\n    </tr>\n    <tr>\n      <th>21</th>\n      <td>23</td>\n      <td>Gorontalo</td>\n      <td>0.00258</td>\n      <td>0.00227</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>19</th>\n      <td>21</td>\n      <td>Kalimantan Selatan</td>\n      <td>0.00255</td>\n      <td>0.00203</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>7</th>\n      <td>8</td>\n      <td>Sumatera Utara</td>\n      <td>0.00240</td>\n      <td>0.00194</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>13</th>\n      <td>14</td>\n      <td>Sumatera Selatan</td>\n      <td>0.00220</td>\n      <td>0.00184</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>12</th>\n      <td>13</td>\n      <td>Jambi</td>\n      <td>0.00214</td>\n      <td>0.00205</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>18</th>\n      <td>20</td>\n      <td>Kalimantan Timur</td>\n      <td>0.00213</td>\n      <td>0.00146</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>30</th>\n      <td>32</td>\n      <td>Maluku</td>\n      <td>0.00209</td>\n      <td>0.00151</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>16</th>\n      <td>17</td>\n      <td>Kalimantan Barat</td>\n      <td>0.00181</td>\n      <td>0.00176</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>10</th>\n      <td>11</td>\n      <td>Kepulauan Riau</td>\n      <td>0.00176</td>\n      <td>0.00152</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>9</th>\n      <td>10</td>\n      <td>Riau</td>\n      <td>0.00160</td>\n      <td>0.00137</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>11</th>\n      <td>12</td>\n      <td>Kepulauan Bangka Belitung</td>\n      <td>0.00153</td>\n      <td>0.00178</td>\n      <td>True</td>\n    </tr>\n    <tr>\n      <th>22</th>\n      <td>24</td>\n      <td>Sulawesi Tengah</td>\n      <td>0.00153</td>\n      <td>0.00117</td>\n      <td>False</td>\n    </tr>\n    <tr>\n      <th>23</th>\n      <td>25</td>\n      <td>Sulawesi Barat</td>\n      <td>0.00128</td>\n      <td>0.00222</td>\n      <td>True</td>\n    </tr>\n    <tr>\n      <th>24</th>\n      <td>26</td>\n      <td>Sulawesi Selatan</td>\n      <td>0.00115</td>\n      <td>0.00093</td>\n      <td>False</td>\n    </tr>\n  </tbody>\n</table>\n</div>"
